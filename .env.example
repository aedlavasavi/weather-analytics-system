# Environment configuration for Cloud-Based Weather Data Analytics System
# Copy this file to .env and adjust variables as needed.

# --- Web App ---
PORT=5000
CACHE_TTL_SECONDS=600

# --- Data Lake Storage Backend ---
# STORAGE_BACKEND=local    : stores data lake locally in DATA_LAKE_DIR (default: ./datalake)
# STORAGE_BACKEND=s3       : uses AWS S3 (or MinIO) object storage for data lake and summary results
# STORAGE_BACKEND=supabase : uses Supabase Storage bucket for data lake and summary results
STORAGE_BACKEND=local
DATA_LAKE_DIR=./datalake

# --- Amazon S3 Configuration (Used when STORAGE_BACKEND=s3) ---
S3_BUCKET=weather-data-lake
AWS_REGION=ap-south-1

# S3 endpoint URL: Leave EMPTY for real AWS S3; set e.g. http://localhost:9000 for MinIO
S3_ENDPOINT_URL=

# AWS Credentials:
# Leave EMPTY to use IAM roles (EC2/ECS/EKS) or AWS CLI config (~/.aws/credentials).
# Or set explicitly for development:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Supabase Storage Configuration (Used when STORAGE_BACKEND=supabase) ---
# Supabase project URL (e.g. https://abcdefghijklmnopqrst.supabase.co)
SUPABASE_URL=
# Supabase API key (anon key or service_role key)
SUPABASE_KEY=
# Supabase Storage bucket name (must already exist or will be auto-created if permissions allow)
SUPABASE_BUCKET=weather-data-lake

# --- Apache Spark Batch Pipeline ---
# PIPELINE_ENGINE: spark (default, requires Java 17/21) | pandas (no Java needed) | duckdb
PIPELINE_ENGINE=spark
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8

# SPARK_IO_MODE: auto (default) | spark | driver
# On Windows, auto safely uses driver mode (pandas + pyarrow) to avoid missing Hadoop winutils.exe
SPARK_IO_MODE=auto
